# ============================================================
# AI 模拟面试 (interview-helper) - P0 环境变量配置示例
# ============================================================

# 离线零 API Key 演示模式（true 时完全跳过外部模型请求）
MOCK_MODE=false

# -------------------- 三阶段独立 BYOK 配置 --------------------
# Prep 预规划阶段（生成简历-JD差距点与4-5个核心考点题纲）
PREP_LLM_BASE_URL=http://127.0.0.1:8790/v1
PREP_LLM_API_KEY=sk-local
PREP_LLM_MODEL=gemini/gemini-3.8-flash

# Live 面试对话阶段（低延迟慢环评估与静态前缀对话生成）
LIVE_LLM_BASE_URL=http://127.0.0.1:8790/v1
LIVE_LLM_API_KEY=sk-local
LIVE_LLM_MODEL=gemini/gemini-3.8-flash

# Post 赛后复盘裁判阶段（输出证据锚定结构化 JSON）
JUDGE_LLM_BASE_URL=http://127.0.0.1:8790/v1
JUDGE_LLM_API_KEY=sk-local
JUDGE_LLM_MODEL=gemini/gemini-3.8-flash

# -------------------- 轻量语音插件配置 --------------------
# TTS: edge_tts | web_speech | none (预留 kokoro / openai_tts)
TTS_PROVIDER=edge_tts
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%

# STT: web_speech | openai_stt | text_only (预留 livekit_smart_turn)
STT_PROVIDER=web_speech
STT_BASE_URL=http://127.0.0.1:8790/v1
STT_API_KEY=sk-local
STT_MODEL=whisper-1

# -------------------- 数据与外网代理 --------------------
DATABASE_URL=sqlite+aiosqlite:///../data/interview.db
GITHUB_PROXY=http://127.0.0.1:7897
REPOMIX_MAX_TOKENS=20000

# -------------------- 前端配置 --------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
